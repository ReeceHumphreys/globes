{
  "name": "tiled-globe",
  "version": "0.1.0",
  "description": "Spherical tiled globe rendering and streaming for Three.js WebGPU",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.lib.json",
    "test": "node --test tests/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p examples/viewer",
    "format": "prettier --write .",
    "docs": "npx -y -p typescript@6.0 -p typedoc@0.28.20 typedoc",
    "prepack": "npm run build",
    "dev": "vite examples/viewer",
    "build:example": "vite build examples/viewer",
    "preview": "vite preview examples/viewer",
    "data:ocean-mask": "node examples/viewer/scripts/ocean-mask.ts",
    "data:usa-coastline": "node examples/viewer/scripts/usa-coastline.ts"
  },
  "dependencies": {
    "pmtiles": "4.5.0"
  },
  "peerDependencies": {
    "three": ">=0.186.0 <0.187.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "prettier": "^3.9.10",
    "three": "^0.186.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
