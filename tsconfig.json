{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "tiled-globe": ["./src/index.ts"]
    }
  },
  "include": ["src", "examples", "vite.config.ts", "vite.lib.config.ts", "benchmarks"]
}
